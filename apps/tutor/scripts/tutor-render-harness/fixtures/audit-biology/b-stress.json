     "note": "Stores water and keeps the cell firm (turgor pressure)"
    },
    {
     "organelle": "cell-wall",
     "note": "Rigid cellulose layer that supports and protects the cell"
    },
    {
     "organelle": "mitochondria",
     "note": "Releases energy from glucose by aerobic respiration"
    }
   ]
  }
 },
 {
