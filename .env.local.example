# Database
MONGODB_URI=mongodb://evelyn:your_password@127.0.0.1:2710/evelyn?replicaSet=rs0&authSource=evelyn

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@evelynlearning.com
EMAIL_TO=contact@evelynlearning.com

# OpenAI (optional - for other AI features)
OPENAI_API_KEY=sk-your-openai-key

# Unsplash (for blog featured images)
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# Cloudinary (for blog image storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Site Config
NEXT_PUBLIC_SITE_URL=https://evelynlearning.com
NEXT_PUBLIC_SITE_NAME=Evelyn Learning

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-GGMVMR276G

# AI Tutor - Voice Pipeline
DEEPGRAM_API_KEY=your-deepgram-api-key
CARTESIA_API_KEY=your-cartesia-api-key

# AI Tutor - LLM (uses existing ANTHROPIC_API_KEY if present)
ANTHROPIC_API_KEY=your-anthropic-api-key

# AI Tutor - Voice Settings (set via env to hide UI options)
# Voice engine: 'openai' (low latency, expensive) or 'classic' (Deepgram+Claude, cheaper)
NEXT_PUBLIC_TUTOR_VOICE_ENGINE=classic
# OpenAI voices: shimmer, coral, echo, alloy, sage, verse
NEXT_PUBLIC_TUTOR_VOICE_OPENAI=alloy
# Classic voices: female-1 (Sarah), female-2 (Emma), male-1 (James), male-2 (Alex)
NEXT_PUBLIC_TUTOR_VOICE_CLASSIC=male-1
