# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Testing
/coverage

# Next.js
.next/
/out/

# Production
/build

# Misc
.DS_Store
*.pem

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local env files (secrets - never commit)
.env*.local
.env.local.production

# Reference files (not part of deployed app)
AI Offerings/

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Ketcher bundle (built from: node scripts/build-ketcher.mjs)
# Re-anchored for the M1a split: these patterns contain a slash, so git
# anchors them to THIS directory. `public/...` stopped matching anything the
# moment public/ moved to apps/*/public/, leaving a multi-MB generated
# bundle.js untracked AND unignored, one `git add -A` away from being
# committed.
apps/*/public/ketcher/bundle.*

# Task E8 headless-harness fixture (written at run time by
# scripts/test-e8-expand-harness.ts, removed on exit — never a deploy asset)
apps/*/public/_e8-harness/

# Deploy manifest (regenerated on every deploy by deploy-tutor.sh /
# deploy-marketing.sh, which replaced deploy-to-production.sh)
.deploy-public-manifest
.deploy-static-manifest
.deploy-server-chunks-manifest

# Script build caches (e.g. Natural Earth GeoJSON for generate-map-backgrounds.ts)
# Re-anchored for the M1a split. The generator builds its path from __dirname
# (apps/tutor/scripts/generate-map-backgrounds.ts:24, `join(__dirname, '.cache')`),
# so the cache can only ever land in the tutor's scripts/ — not marketing's,
# which has no .cache producer.
apps/tutor/scripts/.cache/

# AP source corpus (textbook PDFs + extracted text, downloaded via scripts/extract-ap-corpus.ts)
# Re-anchored for the M1a split. Also __dirname-relative
# (apps/tutor/scripts/extract-ap-corpus.ts:161, `join(__dirname, '..', 'data',
# 'ap-source-corpus', course)`), so it resolves to apps/tutor/data/ regardless
# of where the script is invoked from.
apps/tutor/data/ap-source-corpus/

# tutor-e2e test artifacts
artifacts/
sketch-review/
.claude/worktrees/
.superpowers/

# voice-harness generated corpus audio (fetched via scripts/tutor/voice-harness/fetch-corpus.ts)
# Re-anchored for the M1a split. This one is cwd-relative
# (apps/tutor/scripts/tutor/voice-harness/fetch-corpus.ts:10,
# `join(process.cwd(), 'scripts', 'tutor', 'voice-harness', 'corpus')`) and its
# only entry point is `voice:corpus` in apps/tutor/package.json:203 — npm sets
# cwd to the workspace dir, so it resolves under apps/tutor/. The corpus
# directory already exists there; it just holds no audio yet.
apps/tutor/scripts/tutor/voice-harness/corpus/**/*.wav
apps/tutor/scripts/tutor/voice-harness/corpus/**/*.mp3
apps/tutor/scripts/tutor/voice-harness/corpus/**/*.flac
.env.local.bak*

# Problem-bank gap manifests (generated by scripts/problem-bank-gap-manifest.ts)
.gap-manifests/
.worktrees/
